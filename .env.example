# Copiez ce fichier vers `.env` puis renseignez les valeurs.

# Emplacement de la base SQLite (libSQL). Chemin relatif à la racine du projet.
DATABASE_URL="file:./data/proxitech.db"

# Clé de signature des sessions (32 caractères minimum).
# Générez-en une avec : openssl rand -base64 48
SESSION_SECRET=""

# Mot de passe commun aux comptes de démonstration créés par « npm run db:seed » (facultatif).
# Vide : un mot de passe aléatoire est généré et affiché à la fin du seed.
# 12 caractères minimum, avec au moins une lettre et un chiffre.
SEED_PASSWORD=""

# Assistant « Une question ? » (facultatif).
# Sans clé : l'assistant répond à partir des questions fréquentes du site.
# Avec une clé Groq gratuite (https://console.groq.com/keys) : réponses rédigées par une IA open source.
GROQ_API_KEY=""
# Modèle utilisé (par défaut : openai/gpt-oss-120b).
GROQ_MODEL=""
# Plafond d'appels à Groq par jour, tous visiteurs confondus (par défaut : 500). Au-delà : réponses de la FAQ.
GROQ_DAILY_LIMIT=""

# ─── Informations légales (pages /mentions-legales, /confidentialite, /cgu) ───
# Ne les écrivez jamais dans le dépôt (il est public) : renseignez-les dans .env ou chez l'hébergeur.
# Une valeur absente s'affiche « [à compléter] » sur le site.
LEGAL_EDITOR_NAME=""            # ex. : Association Proxi'Clic, ou les noms des membres du projet
LEGAL_EDITOR_STATUS=""          # ex. : Association loi 1901 / Projet étudiant non commercial (Ynov Campus)
LEGAL_EDITOR_ADDRESS=""         # adresse postale (facultative pour une personne physique non professionnelle)
LEGAL_EDITOR_REGISTRATION=""    # n° RNA ou SIREN, s'il existe
LEGAL_PUBLICATION_DIRECTOR=""   # nom du directeur ou de la directrice de la publication
LEGAL_CONTACT_EMAIL=""          # adresse de contact (droits RGPD, signalements) — active les liens « Signaler »
LEGAL_HOST="vercel"             # vercel ou contabo : hébergeur affiché dans les mentions légales
LEGAL_HOST_PHONE=""             # téléphone de l'hébergeur (obligatoire, LCEN art. 6), à relever sur son site
